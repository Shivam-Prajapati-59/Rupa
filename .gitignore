*.rupa-bak

# Secrets and local config
.env
.env.*
*.pem
*.key

# Per-machine agent settings (project skills in .claude/skills ARE committed)
.claude/settings.local.json

# Logs and crash dumps from local runs
*.log
crash-*.txt

# OS and editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
